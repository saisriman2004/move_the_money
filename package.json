{
  "name": "move-the-money",
  "version": "1.0.0",
  "description": "Money transfer API with PostgreSQL",
  "main": "dist/index.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "test:log": "tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=test-results.log test/*.test.ts",
    "lint": "eslint .",
    "worker:outbox": "tsx src/workers/outbox-relay.ts",
    "worker:webhooks": "tsx src/workers/webhooks.ts",
    "worker:notifications": "tsx src/workers/notifications.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0"
  }
}
