PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://localhost:5432/move_money
# debug | info | warn | error | silent
LOG_LEVEL=info
# JSON lines, one per request and per error. Set to "off" to log to the console only.
LOG_FILE=logs/app.log
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_TTL_SECONDS=3600
# Percentage fee charged to the sender of each transfer, e.g. 1 or 0.25. 0 disables fees.
TRANSFER_FEE_PERCENT=1
RABBITMQ_URL=amqp://guest:guest@localhost:5672
AMQP_PREFIX=mtm.
# Consumer retry delays in ms before a failing message is dead-lettered.
CONSUMER_RETRY_DELAYS_MS=1000,5000,25000
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=mtm:
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10
ACCOUNT_CACHE_TTL_SECONDS=30
# Risk rules: review or reject large amounts, cap transfers per minute per account,
# review large transfers from new accounts, block accounts with repeated rejections.
RISK_REVIEW_AMOUNT=1000.00
RISK_REJECT_AMOUNT=10000.00
RISK_MAX_TRANSFERS_PER_MINUTE=10
RISK_NEW_ACCOUNT_HOURS=24
RISK_NEW_ACCOUNT_REVIEW_AMOUNT=500.00
RISK_MAX_RECENT_REJECTIONS=3
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_BASE_MS=10000
# Allow webhook URLs on localhost / private networks. Only for local development.
WEBHOOK_ALLOW_PRIVATE_URLS=true
# How often the reconciliation worker audits the ledger (default: hourly).
RECONCILIATION_INTERVAL_MS=3600000
# Comma-separated browser origins allowed to call the API, e.g. http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Number of proxies in front of the API (0/false when clients connect directly).
TRUST_PROXY=false
# If set, GET /metrics requires Authorization: Bearer <METRICS_TOKEN>.
METRICS_TOKEN=
# Each worker serves /metrics and /health on its own port (defaults 9101-9104).
