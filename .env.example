PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://localhost:5432/move_money
# debug | info | warn | error | silent
LOG_LEVEL=info
# JSON lines, one per request and per error. Set to "off" to log to the console only.
LOG_FILE=logs/app.log
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_TTL_SECONDS=3600
# Percentage fee charged to the sender of each transfer, e.g. 1 or 0.25. 0 disables fees.
TRANSFER_FEE_PERCENT=1
RABBITMQ_URL=amqp://guest:guest@localhost:5672
AMQP_PREFIX=mtm.
# Consumer retry delays in ms before a failing message is dead-lettered.
CONSUMER_RETRY_DELAYS_MS=1000,5000,25000
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=mtm:
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10
ACCOUNT_CACHE_TTL_SECONDS=30
