PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://localhost:5432/move_money
# debug | info | warn | error | silent
LOG_LEVEL=info
# JSON lines, one per request and per error. Set to "off" to log to the console only.
LOG_FILE=logs/app.log
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_TTL_SECONDS=3600
